@model BlogCoreSolution.Models.Article
@{
    ViewData["Title"] = "Detalle Artículo";
}

<br />
<div class="container">
    <div class="card">
        <div class="card-header bg-light text-light">
            <div class="col-12">
                <h1 class="text-center text-primary">@Model.Name</h1>
            </div>
            <div class="col-12">
                <p class="text-muted">Fecha: @Model.CreationDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
        <div class="card-body">
            <div class="col-12">
                <img src="@Model.UrlImage" class="img-thumbnail mx-auto d-block" />
                <p class="text-secondary">
                    @Html.Raw(Model.Description);
                </p>
            </div>
        </div>
        <div class="card-footer">
            <div class="row">
                <div class="col-12 col-md-6 pb-1">
                    <a asp-action="Index" class="btn btn-success btn-sm">Volver atrás</a>
                </div>
            </div>
        </div>
    </div>
</div>