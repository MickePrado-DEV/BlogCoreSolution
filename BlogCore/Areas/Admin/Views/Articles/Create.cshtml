@model BlogCoreSolution.Models.ViewModels.ArticleVM
@{
    ViewData["Title"] = "Crear Artículo";
}

<br />
<br />
<h2 class="text-center">Crear un nuevo Artículo</h2>
<form method="POST" asp-action="Create" enctype="multipart/form-data">
    <div class="row px-2 offset-1 border">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="col-10 offser-1 mt-4">
            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="Article.Name"></label>
                </div>
                <div class="col-8">
                    <input asp-for="Article.Name" class="form-control" placeholder="Ingresa el nombre del artículo" />
                    <span asp-validation-for="Article.Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="Article.Description"></label>
                </div>
                <div class="col-8">
                    <textarea asp-for="Article.Description" id="Contenido" class="form-control" style="height: 300px;"></textarea>
                    <span asp-validation-for="Article.Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mt-2">
                <div class="col-4">
                    <label for="Category">Categoría</label>
                </div>
                <div class="col-8">
                    @Html.DropDownListFor(m => m.Article.CategoryId, Model.ListOfCategories,
                    "-Por favor seleccione una categoría-", new { @class = "form-control" })
                    <span asp-validation-for="Article.CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="Article.UrlImage"></label>
                </div>
                <div class="col-8">
                    <input type="file" class="form-control" name="archives" id="uploadArchive" />
                    <span asp-validation-for="Article.UrlImage" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group-row mt-4">
                <div class="col-8">
                    <partial name="_ViewCreateBack" />
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simplemde@1.11.2/dist/simplemde.min.css">
    <script src="https://cdn.jsdelivr.net/npm/simplemde@1.11.2/dist/simplemde.min.js"></script>
    <script>
        new SimpleMDE({ element: document.getElementById("Contenido") });
    </script>
}