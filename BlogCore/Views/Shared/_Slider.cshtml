@model BlogCoreSolution.Models.ViewModels.HomeVM
<!--Slider-->
<div id="sliderImages" class="carousel slide">
    <div class="carousel-inner">
        @{
            var slidersActivos = Model.SlidersList.Where(s => s.Status).ToList();
        }

        @if (Model?.SlidersList != null)
        {
            @for (int i = 0; i < slidersActivos.Count; i++)
            {
                var itemDinamico = i == 0 ? "active" : "";

                <div class="carousel-item @itemDinamico">
                    <img src="@Url.Content(slidersActivos[i].UrlImage)" class="d-block w-100" />
                    <h1 class="text-white text-center bg-dark py-1">
                        @Html.Raw(slidersActivos[i].Name)
                    </h1>
                </div>
            }
        }
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#sliderImages" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#sliderImages" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>
<!--Cierra Slider-->