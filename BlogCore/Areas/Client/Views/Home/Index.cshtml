@model BlogCoreSolution.Models.ViewModels.HomeVM

@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <div class="col-sm-12">
        <h1 class="text-center text-dark bg-secondary py-1">Últimos Cursos y Tutoriales</h1>
    </div>
</div>
   
@if (Model.ArticleList.Count() > 0)
{
    <hr />
    <div class="row">
        @foreach (var articulo in Model.ArticleList.OrderBy(o => o.Id))
        {
            <div class="col-4">
                <div class="card">
                    <img src="@articulo.UrlImage" class="img-thumbnail" width="100%" />
                    <h5 class="card-body">@articulo.Name</h5>
                    <a asp-action="Detail" class="btn btn-success"
                           style="border-radius: 10px" asp-route-id="@articulo.Id">
                        Más información
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No hay artículos</p>
}