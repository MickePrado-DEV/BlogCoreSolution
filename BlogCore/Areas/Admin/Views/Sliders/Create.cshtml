@model BlogCoreSolution.Models.Slider
@{
    ViewData["Title"] = "Crear Slider";
}

<br />
<br />
<h2 class="text-center">Crear un nuevo Slider</h2>
<form method="POST" asp-action="Create" enctype="multipart/form-data">
    <div class="row px-2 offset-1 border">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="col-10 offser-1 mt-4">
            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="Name"></label>
                </div>
                <div class="col-8">
                    <input asp-for="Name" class="form-control" placeholder="Ingresa el nombre del artículo" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="Status"></label>
                </div>
                <div class="col-8">
                    <input type="checkbox" asp-for="Status"/>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>


            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="UrlImage"></label>
                </div>
                <div class="col-8">
                    <input type="file" class="form-control" name="archives" id="uploadArchive" />
                    <span asp-validation-for="UrlImage" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group-row mt-4">
                <div class="col-8">
                    <partial name="_ViewCreateBack" />
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }

}