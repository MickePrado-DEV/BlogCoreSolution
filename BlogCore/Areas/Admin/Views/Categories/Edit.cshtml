@model BlogCoreSolution.Models.Category
@{
    ViewData["Title"] = "Editar Categoría";
}

<br />
<br />
<h2 class="text-center">Editar Categoría</h2>
<form method="POST" asp-action="Edit">
    <div class="row px-2 offset-1 border">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="col-10 offser-1 mt-4">
            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="Name"></label>
                </div>
                <div class="col-8">
                    <input asp-for="Name" class="form-control" placeholder="Ingresa el nombre de categoría" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mt-2">
                <div class="col-4">
                    <label asp-for="Order"></label>
                </div>
                <div class="col-8">
                    <input asp-for="Order" class="form-control" placeholder="Ingresa el orden de categoría" />
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group-row mt-4">
                <div class="col">
                    <div class="row">
                        <div class="col">
                            <button type="submit" class="btn btn-primary form-control">Editar</button>
                        </div>
                        &nbsp;
                        <div class="col">
                            <a asp-action="Index" class="btn btn-success form-control">Volver atrás</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}