<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlogCore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BlogCore.styles.css" asp-append-version="true" />

    <!--Css todos-->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.css" />


</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><<img src="~/images/blogger.png" alt="Alternate Text"  width="60"/></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Client/Home/Index">Home</a>
                        </li>

                        @if(User.Identity.IsAuthenticated && User.IsInRole("Admin")){
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white-50" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
                                    Administrar Contenidos
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="/Admin/Categories/Index">Categorías</a>
                                    <a class="dropdown-item" href="/Admin/Articles/Index">Artículos</a>
                                    <a class="dropdown-item" href="/Admin/Sliders/Index">Sliders</a>
                                    <a class="dropdown-item" href="/Admin/Users/Index">Usuarios</a>
                                </div>
                            </li>
                        }
               
   
                       
                    </ul>
                    <!-- Formulario-->
                    <div class="d-flex align-items-center ms-auto me-3">
                        <form class="busqueda d-flex  ms-3 mr-4"
                              asp-controller="Home" asp-action="SearchResult"
                              method="GET">
                            <input class="form-control text-dark" type="text" name="searchString" placeholder="ingresa lo que quieres buscar" />
                            <button class="btn btn-success mx-2" type="submit"><i class="bi bi-search"></i></button>
                        </form>
                    </div>
                   
                  
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
        <!--Aquí vista parcial slider-->
        @if (ViewBag.IsHome == true )
        {
            <partial name="_Slider"  />
        }

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!--Banner-->
    <div class="container-fluid banner-container">
        <div class="container banner-content">
            <button type="button" class="btn btn-secondary subscibe-btn">
                Suscribete a nuestro Blog
            </button>
        </div>

    </div>

    <footer class="border-top footer text-muted bg-dark" style="background-color: #1a1a1a !important">
        <div class="container p-4">
            <span class="text-white">&copy; 2025 - BlogCore. Desarrollado por: Micke Prado</span>
            
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!--Js plugins-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery.serializeJSON/3.2.1/jquery.serializejson.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.js"></script>


    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
